<?xml version="1.0" encoding="utf-8"?>

<layer-list
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- SOMBRA PROFUNDA -->
    <item
        android:left="2dp"
        android:top="6dp"
        android:right="2dp"
        android:bottom="0dp">

        <shape android:shape="rectangle">

            <solid android:color="#35000000" />

            <corners
                android:radius="40dp" />

        </shape>

    </item>


    <!-- SOMBRA INTERMEDIA -->
    <item
        android:left="1dp"
        android:top="3dp"
        android:right="1dp"
        android:bottom="3dp">

        <shape android:shape="rectangle">

            <solid android:color="#18000000" />

            <corners
                android:radius="40dp" />

        </shape>

    </item>


    <!-- BARRA -->
    <item
        android:bottom="5dp">

        <shape android:shape="rectangle">

            <solid android:color="#FFFFFF" />

            <stroke
                android:width="1dp"
                android:color="#FFD54F" />

            <corners
                android:radius="40dp" />

        </shape>

    </item>

</layer-list>