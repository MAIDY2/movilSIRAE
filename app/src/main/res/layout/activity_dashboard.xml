<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanco"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/blanco">

        <!-- CONTENIDO CON MÁRGENES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="24dp">

            <!-- ================================================= -->
            <!-- ENCABEZADO -->
            <!-- ================================================= -->

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- INFORMACIÓN DEL USUARIO -->

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="¡Hola, Laura!"
                        android:textColor="@color/negro"
                        android:textSize="27sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Manipuladora"
                        android:textColor="@color/gris"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="370dp"
                        android:layout_height="90dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_fecha"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="15dp"
                        android:paddingEnd="15dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hoy"
                                android:textColor="@color/negro"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtFecha"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="9dp"
                                android:text="Martes, 6 de mayo de 2025"
                                android:textColor="@color/gris"
                                android:textSize="14sp" />

                        </LinearLayout>

                        <ImageView
                            android:id="@+id/imgCalendario"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/ic_calendar"
                            android:tint="@color/negro"
                            android:contentDescription="Calendario" />

                    </LinearLayout>

                </LinearLayout>

                <!-- NOTIFICACIONES -->

                <ImageView
                    android:id="@+id/btnNotificaciones"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_alignParentEnd="true"
                    android:contentDescription="Notificaciones"
                    android:src="@drawable/ic_notifications"
                    android:tint="@color/negro" />

            </RelativeLayout>


            <!-- ESPACIO ENTRE ENCABEZADO Y BOTONES -->

            <Space
                android:layout_width="match_parent"
                android:layout_height="2dp" />


            <!-- ================================================= -->
            <!-- FILA 1 -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">


                <!-- ================= MENÚ DEL DÍA ================= -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMenu"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardBackgroundColor="@color/blanco"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/borde"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="11dp">

                        <ImageView
                            android:layout_width="58dp"
                            android:layout_height="58dp"
                            android:background="@color/amarillo"
                            android:contentDescription="Menú"
                            android:padding="13dp"
                            android:src="@drawable/ic_menu"
                            android:tint="@color/blanco" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="9dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:text="Menú del día"
                                android:textColor="@color/negro"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:maxLines="1"
                                android:text="Ver menú"
                                android:textColor="@color/gris"
                                android:textSize="13sp" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- ================= ASISTENCIA ================= -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAsistencia"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardBackgroundColor="@color/blanco"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/borde"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="11dp">

                        <ImageView
                            android:layout_width="58dp"
                            android:layout_height="58dp"
                            android:background="@color/verde"
                            android:contentDescription="Asistencia"
                            android:padding="13dp"
                            android:src="@drawable/ic_people"
                            android:tint="@color/blanco" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="9dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:text="Asistencia"
                                android:textColor="@color/negro"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:maxLines="2"
                                android:text="Registrar niños"
                                android:textColor="@color/gris"
                                android:textSize="13sp" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>


            <!-- ESPACIO -->

            <Space
                android:layout_width="match_parent"
                android:layout_height="14dp" />


            <!-- ================================================= -->
            <!-- FILA 2 -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">


                <!-- ================= PREPARACIÓN ================= -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPreparacion"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardBackgroundColor="@color/blanco"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/borde"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="11dp">

                        <ImageView
                            android:layout_width="58dp"
                            android:layout_height="58dp"
                            android:background="@color/amarillo"
                            android:contentDescription="Preparación"
                            android:padding="13dp"
                            android:src="@drawable/ic_preparation"
                            android:tint="@color/blanco" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="9dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:text="Preparación"
                                android:textColor="@color/negro"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:maxLines="1"
                                android:text="Paso a paso"
                                android:textColor="@color/gris"
                                android:textSize="13sp" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- ================= INVENTARIO ================= -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardInventario"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardBackgroundColor="@color/blanco"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/borde"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="11dp">

                        <ImageView
                            android:layout_width="58dp"
                            android:layout_height="58dp"
                            android:background="@color/amarillo"
                            android:contentDescription="Inventario"
                            android:padding="13dp"
                            android:src="@drawable/ic_inventory"
                            android:tint="@color/blanco" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="9dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:text="Inventario"
                                android:textColor="@color/negro"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:maxLines="1"
                                android:text="Ver inventario"
                                android:textColor="@color/gris"
                                android:textSize="13sp" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>


            <!-- ESPACIO -->

            <Space
                android:layout_width="match_parent"
                android:layout_height="14dp" />


            <!-- ================================================= -->
            <!-- FILA 3 -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">


                <!-- ================= REPORTES ================= -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardReportes"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardBackgroundColor="@color/blanco"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/borde"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="11dp">

                        <ImageView
                            android:layout_width="58dp"
                            android:layout_height="58dp"
                            android:background="@color/azul"
                            android:contentDescription="Reportes"
                            android:padding="13dp"
                            android:src="@drawable/ic_reports"
                            android:tint="@color/blanco" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="9dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:text="Reportes"
                                android:textColor="@color/negro"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:maxLines="1"
                                android:text="Ver reportes"
                                android:textColor="@color/gris"
                                android:textSize="13sp" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- ================= AVISOS ================= -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAvisos"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardBackgroundColor="@color/blanco"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/borde"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="11dp">

                        <ImageView
                            android:layout_width="58dp"
                            android:layout_height="58dp"
                            android:background="@color/naranja"
                            android:contentDescription="Avisos"
                            android:padding="13dp"
                            android:src="@drawable/ic_notifications"
                            android:tint="@color/blanco" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="9dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:text="Avisos"
                                android:textColor="@color/negro"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:maxLines="1"
                                android:text="Novedades"
                                android:textColor="@color/gris"
                                android:textSize="13sp" />

                        </LinearLayout>

                    </LinearLayout>


                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>

        <!-- ESPACIO ENTRE TARJETAS Y PAISAJE -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="10dp" />

        <!-- ========================================= -->
        <!-- PAISAJE A TODO EL ANCHO DE LA PANTALLA -->
        <!-- ========================================= -->

        <ImageView
            android:id="@+id/imgPaisaje"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="@color/blanco"
            android:contentDescription="Paisaje"
            android:scaleType="fitXY"
            android:src="@drawable/paisaje" />

    </LinearLayout>

</ScrollView>