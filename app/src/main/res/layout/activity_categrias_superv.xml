<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    tools:ignore="HardcodedText">

    <!-- MARCO AMARILLO SUPERIOR REDONDEADO -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/headerBackground"
        android:layout_width="0dp"
        android:layout_height="130dp"
        android:layout_marginTop="-20dp"
        app:cardBackgroundColor="#FFC107"
        app:cardCornerRadius="30dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- CÍRCULO DECORATIVO -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginEnd="-30dp"
        android:layout_marginTop="-30dp"
        app:cardBackgroundColor="#FFD54F"
        app:cardCornerRadius="70dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- CONTENIDO DESPLAZABLE (COMIENZA DEBAJO DEL MARCO AMARILLO) -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@+id/bottomMenu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="28dp">

            <!-- BARRA SUPERIOR (CON BOTÓN MENÚ, LOGO Y PERFIL) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnMenu"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:background="@drawable/boton_borde_amarillo"
                    android:clickable="true"
                    android:contentDescription="Abrir menú lateral"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="🍔"
                    android:textSize="20sp" />

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:contentDescription="Logo del programa PAE"
                    android:scaleType="centerInside"
                    android:src="@drawable/logo_pae" />

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/circulo_verde"
                    android:contentDescription="Perfil de usuario"
                    android:gravity="center"
                    android:text="CM"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- TITULO Y DESCRIPCIÓN -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Categorías 🏷️"
                android:textColor="#10231D"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Gestiona las categorías de los productos del inventario 📦"
                android:textColor="#667085"
                android:textSize="14sp" />

            <!-- BOTON NUEVA CATEGORIA -->
            <Button
                android:id="@+id/btnNuevaCategoria"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_gravity="end"
                android:layout_marginTop="16dp"
                android:background="@drawable/boton_verde"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="➕ Nueva categoría"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- BUSCADOR -->
            <EditText
                android:id="@+id/txtBuscar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:autofillHints="none"
                android:background="@drawable/buscador"
                android:hint="🔍 Buscar por categoría..."
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:textColor="#344054"
                android:textColorHint="#98A2B3"
                android:textSize="15sp" />

            <!-- CATEGORIA: GRANOS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/tarjeta"
                android:gravity="center_vertical"
                android:minHeight="140dp"
                android:padding="16dp">

                <TextView
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:background="@drawable/circulo_granos"
                    android:gravity="center"
                    android:text="🌾"
                    android:textSize="30sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Granos 🌾"
                        android:textColor="#10203A"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Cereales, legumbres y afines 🥣"
                        android:textColor="#667085"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/activo"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="Activo ✅"
                        android:textColor="#12A150"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnEditarGranos"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:clickable="true"
                        android:contentDescription="Editar categoría granos"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="✏️"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/btnEliminarGranos"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:clickable="true"
                        android:contentDescription="Eliminar categoría granos"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="🗑️"
                        android:textSize="18sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- CATEGORIA: PROTEINAS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/tarjeta"
                android:gravity="center_vertical"
                android:minHeight="140dp"
                android:padding="16dp">

                <TextView
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:background="@drawable/circulo_proteinas"
                    android:gravity="center"
                    android:text="🥩"
                    android:textSize="30sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Proteínas 🥩"
                        android:textColor="#10203A"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Carnes, pollo, huevos y legumbres 🍗🥚"
                        android:textColor="#667085"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/activo"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="Activo ✅"
                        android:textColor="#12A150"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnEditarProteinas"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:clickable="true"
                        android:contentDescription="Editar categoría proteínas"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="✏️"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/btnEliminarProteinas"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:clickable="true"
                        android:contentDescription="Eliminar categoría proteínas"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="🗑️"
                        android:textSize="18sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- CATEGORIA: ABARROTES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/tarjeta"
                android:gravity="center_vertical"
                android:minHeight="140dp"
                android:padding="16dp">

                <TextView
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:background="@drawable/circulo_abarrotes"
                    android:gravity="center"
                    android:text="🛒"
                    android:textSize="30sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Abarrotes 🛒"
                        android:textColor="#10203A"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Aceites, sal, azúcar, productos secos 🛢️"
                        android:textColor="#667085"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/activo"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="Activo ✅"
                        android:textColor="#12A150"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnEditarAbarrotes"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:clickable="true"
                        android:contentDescription="Editar categoría abarrotes"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="✏️"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/btnEliminarAbarrotes"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:clickable="true"
                        android:contentDescription="Eliminar categoría abarrotes"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="🗑️"
                        android:textSize="18sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- CATEGORIA: VERDURAS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/tarjeta"
                android:gravity="center_vertical"
                android:minHeight="140dp"
                android:padding="16dp">

                <TextView
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:background="@drawable/circulo_verduras"
                    android:gravity="center"
                    android:text="🥦"
                    android:textSize="30sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Verduras 🥦"
                        android:textColor="#10203A"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Verduras y hortalizas 🥕"
                        android:textColor="#667085"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/activo"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="Activo ✅"
                        android:textColor="#12A150"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnEditarVerduras"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:clickable="true"
                        android:contentDescription="Editar categoría verduras"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="✏️"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/btnEliminarVerduras"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:clickable="true"
                        android:contentDescription="Eliminar categoría verduras"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="🗑️"
                        android:textSize="18sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- CATEGORIA: FRUTAS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/tarjeta"
                android:gravity="center_vertical"
                android:minHeight="140dp"
                android:padding="16dp">

                <TextView
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:background="@drawable/circulo_frutas"
                    android:gravity="center"
                    android:text="🍎"
                    android:textSize="30sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Frutas 🍎"
                        android:textColor="#10203A"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Frutas frescas 🍌🍊"
                        android:textColor="#667085"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/no_prioritario"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="No prioritario ⚠️"
                        android:textColor="#E88A00"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnEditarFrutas"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:clickable="true"
                        android:contentDescription="Editar categoría frutas"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="✏️"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/btnEliminarFrutas"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:clickable="true"
                        android:contentDescription="Eliminar categoría frutas"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="🗑️"
                        android:textSize="18sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- MENU INFERIOR FIJO -->
    <LinearLayout
        android:id="@+id/bottomMenu"
        android:layout_width="0dp"
        android:layout_height="75dp"
        android:background="#FFFFFF"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏠"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Inicio"
                android:textColor="#667085"
                android:textSize="11sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚚"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Entregas"
                android:textColor="#667085"
                android:textSize="11sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Inventario"
                android:textColor="#667085"
                android:textSize="11sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Reportes"
                android:textColor="#667085"
                android:textSize="11sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏷️"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Categorías"
                android:textColor="#72BF2C"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>