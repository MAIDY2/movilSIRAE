            android:layout_marginTop="18dp"
            app:cardBackgroundColor="#FFF9DC"
            app:cardCornerRadius="18dp"
            app:cardElevation="1dp"
            app:strokeColor="#FFD21C"
            app:strokeWidth="1dp">

            <LinearLayout
