<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="#FFFFFF"
android:orientation="vertical">

<RelativeLayout
android:layout_width="match_parent"
android:layout_height="56dp"
android:paddingHorizontal="16dp">

<ImageView
android:id="@+id/btnVolver"
android:layout_width="24dp"
android:layout_height="24dp"
android:layout_centerVertical="true"
android:contentDescription="Atrás"
android:src="@android:drawable/ic_menu_revert" />

<TextView
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:layout_centerInParent="true"
android:text="Preparación detallada"
android:textColor="#000000"
android:textSize="18sp"
android:textStyle="bold" />

</RelativeLayout>

<ScrollView
android:layout_width="match_parent"
android:layout_height="0dp"
android:layout_weight="1"
android:fillViewport="true">

<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="vertical"
android:padding="20dp">

<com.google.android.material.card.MaterialCardView
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginBottom="24dp"
app:cardBackgroundColor="#FFF9E6"
app:cardCornerRadius="18dp"
app:cardElevation="0dp"
app:strokeWidth="0dp">

<RelativeLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:padding="18dp">

<LinearLayout
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:layout_alignParentStart="true"
android:layout_centerVertical="true"
android:orientation="vertical">

<TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Frijoles"
    android:textColor="#111111"
    android:textSize="22sp"
    android:textStyle="bold" />

<TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="#FFEAA7"
    android:paddingHorizontal="12dp"
    android:paddingVertical="5dp"
    android:text="Paso 2 de 5"
    android:textColor="#604400"
    android:textSize="12sp"
    android:textStyle="bold" />

</LinearLayout>

    <ImageView

        android:id="@+id/imgPlato"
        android:layout_width="90dp"
        android:layout_height="95dp"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="-40dp"
        android:layout_marginEnd="28dp"
        android:contentDescription="Frijoles"
        android:scaleType="centerCrop"
        android:src="@drawable/frijoles" />

</RelativeLayout>

</com.google.android.material.card.MaterialCardView>

<TextView
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:text="Ingredientes"
android:textColor="#000000"
android:textSize="16sp"
android:textStyle="bold" />

<TableLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginTop="12dp"
android:layout_marginBottom="24dp">

<TableRow android:layout_marginBottom="10dp">
<TextView
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="rijol cargamento"
android:textColor="#222222"
android:textSize="14sp" />
<TextView
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:gravity="end"
android:text="18.0 kg"
android:textColor="#222222"
android:textSize="14sp"
android:textStyle="bold" />
</TableRow>

<TableRow android:layout_marginBottom="10dp">
<TextView
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text=" Agua"
android:textColor="#222222"
android:textSize="14sp" />
<TextView
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:gravity="end"
android:text="36.0 L"
android:textColor="#222222"
android:textSize="14sp"
android:textStyle="bold" />
</TableRow>

<TableRow android:layout_marginBottom="10dp">
<TextView
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="Sal"
android:textColor="#222222"
android:textSize="14sp" />
<TextView
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:gravity="end"
android:text="A gusto"
android:textColor="#222222"
android:textSize="14sp"
android:textStyle="bold" />
</TableRow>

<TableRow>
<TextView
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text=" Ajo"
android:textColor="#222222"
android:textSize="14sp" />
<TextView
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:gravity="end"
android:text="A gusto"
android:textColor="#222222"
android:textSize="14sp"
android:textStyle="bold" />
</TableRow>

</TableLayout>

<!-- Sección Utensilios -->
<TextView
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:text="Utensilios"
android:textColor="#000000"
android:textSize="16sp"
android:textStyle="bold" />

<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginTop="12dp"
android:layout_marginBottom="24dp"
android:orientation="vertical">

<TextView
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:layout_marginBottom="10dp"
android:text="Olla grande"
android:textColor="#222222"
android:textSize="14sp" />

<TextView
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:layout_marginBottom="10dp"
android:text="  Cuchara de madera"
android:textColor="#222222"
android:textSize="14sp" />

<TextView
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text=" Colador"
android:textColor="#222222"
android:textSize="14sp" />

</LinearLayout>

<!-- Sección Pasos sin referencias a drawables que no existen -->
<TextView
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:text="Pasos de preparación"
android:textColor="#000000"
android:textSize="16sp"
android:textStyle="bold" />

<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginTop="12dp"
android:orientation="vertical">

<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginBottom="14dp"
android:orientation="horizontal">
<TextView
android:layout_width="26dp"
android:layout_height="26dp"
android:background="#F2F2F2"
android:gravity="center"
android:text="1"
android:textColor="#000000"
android:textSize="13sp"
android:textStyle="bold" />
<TextView
android:layout_width="0dp"
android:layout_height="wrap_content"
android:layout_marginStart="12dp"
android:layout_weight="1"
android:text="Remojar los frijoles por mínimo 8 horas."
android:textColor="#222222"
android:textSize="14sp" />
</LinearLayout>

<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginBottom="14dp"
android:orientation="horizontal">
<TextView
android:layout_width="26dp"
android:layout_height="26dp"
android:background="#F2F2F2"
android:gravity="center"
android:text="2"
android:textColor="#000000"
android:textSize="13sp"
android:textStyle="bold" />
<TextView
android:layout_width="0dp"
android:layout_height="wrap_content"
android:layout_marginStart="12dp"
android:layout_weight="1"
android:text="Escurrir y lavar los frijoles."
android:textColor="#222222"
android:textSize="14sp" />
</LinearLayout>

<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginBottom="14dp"
android:orientation="horizontal">
<TextView
android:layout_width="26dp"
android:layout_height="26dp"
android:background="#F2F2F2"
android:gravity="center"
android:text="3"
android:textColor="#000000"
android:textSize="13sp"
android:textStyle="bold" />
<TextView
android:layout_width="0dp"
android:layout_height="wrap_content"
android:layout_marginStart="12dp"
android:layout_weight="1"
android:text="Llevar a cocción con agua y ajo."
android:textColor="#222222"
android:textSize="14sp" />
</LinearLayout>

<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginBottom="14dp"
android:orientation="horizontal">
<TextView
android:layout_width="26dp"
android:layout_height="26dp"
android:background="#F2F2F2"
android:gravity="center"
android:text="4"
android:textColor="#000000"
android:textSize="13sp"
android:textStyle="bold" />
<TextView
android:layout_width="0dp"
android:layout_height="wrap_content"
android:layout_marginStart="12dp"
android:layout_weight="1"
android:text="Cocinar a fuego medio hasta que estén blandos."
android:textColor="#222222"
android:textSize="14sp" />
</LinearLayout>

<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginBottom="24dp"
android:orientation="horizontal">
<TextView
android:layout_width="26dp"
android:layout_height="26dp"
android:background="#F2F2F2"
android:gravity="center"
android:text="5"
android:textColor="#000000"
android:textSize="13sp"
android:textStyle="bold" />
<TextView
android:layout_width="0dp"
android:layout_height="wrap_content"
android:layout_marginStart="12dp"
android:layout_weight="1"
android:text="Agregar sal al gusto y mezclar."
android:textColor="#222222"
android:textSize="14sp" />
</LinearLayout>

</LinearLayout>

<!-- Botón Principal -->
<com.google.android.material.button.MaterialButton
android:id="@+id/btnCompletado"
android:layout_width="match_parent"
android:layout_height="52dp"
android:layout_marginBottom="16dp"
android:text="Marcar como completado"
android:textAllCaps="false"
android:textColor="#FFFFFF"
android:textSize="15sp"
android:textStyle="bold"
app:backgroundTint="#FBC02D"
app:cornerRadius="12dp" />

</LinearLayout>

</ScrollView>

<!-- Menú Inferior -->
<LinearLayout
android:layout_width="match_parent"
android:layout_height="62dp"
android:background="#FFFFFF"
android:elevation="12dp"
android:orientation="horizontal">

<LinearLayout
android:layout_width="0dp"
android:layout_height="match_parent"
android:layout_weight="1"
android:gravity="center"
android:orientation="vertical">
<TextView
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="🏠"
android:textSize="18sp" />
<TextView
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="Inicio"
android:textColor="#888888"
android:textSize="10sp" />
</LinearLayout>

<LinearLayout
android:layout_width="0dp"
android:layout_height="match_parent"
android:layout_weight="1"
android:gravity="center"
android:orientation="vertical">
<TextView
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text=""
android:textSize="18sp" />
<TextView
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="Menú"
android:textColor="#888888"
android:textSize="10sp" />
</LinearLayout>

<LinearLayout
android:layout_width="0dp"
android:layout_height="match_parent"
android:layout_weight="1"
android:gravity="center"
android:orientation="vertical">
<TextView
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text=""
android:textSize="18sp" />
<TextView
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="Asistencia"
android:textColor="#888888"
android:textSize="10sp" />
</LinearLayout>

<LinearLayout
android:layout_width="0dp"
android:layout_height="match_parent"
android:layout_weight="1"
android:gravity="center"
android:orientation="vertical">
<TextView
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text=""
android:textSize="18sp" />
<TextView
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="Preparación"
android:textColor="#FBC02D"
android:textSize="10sp"
android:textStyle="bold" />
</LinearLayout>

<LinearLayout
android:layout_width="0dp"
android:layout_height="match_parent"
android:layout_weight="1"
android:gravity="center"
android:orientation="vertical">
<TextView
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="•••"
android:textColor="#888888"
android:textSize="18sp"
android:textStyle="bold" />
<TextView
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="Más"
android:textColor="#888888"
android:textSize="10sp" />
</LinearLayout>

</LinearLayout>

</LinearLayout>