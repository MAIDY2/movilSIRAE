<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="20dp">

        <!-- BARRA SUPERIOR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text=""
            android:textColor="#333333"
            android:textSize="30sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Seleccionar menú "
                android:textColor="#222222"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:text=""
                android:textColor="#333333"
                android:textSize="30sp" />


        </LinearLayout>

        <!-- FECHA -->
        <TextView
            android:id="@+id/txtFecha"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/circulo_numero"
            android:gravity="center"
            android:text="Martes, 6 de mayo de 2025"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- OPCIONES -->
        <RadioGroup
            android:id="@+id/radioGroupMenus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- MENU 1 -->
            <LinearLayout
                android:id="@+id/menu1"
                android:layout_width="match_parent"
                android:layout_height="85dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/borde"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">

                <RadioButton
                    android:id="@+id/radioMenu1"
                    android:layout_width="35dp"
                    android:layout_height="wrap_content"
                    android:buttonTint="#FFC107" />

                <ImageView
                    android:id="@+id/imgMenu1"
                    android:layout_width="65dp"
                    android:layout_height="65dp"
                    android:contentDescription="Arroz con pollo"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="Arroz blanco, frijoles,\npollo guisado, ensalada\nde repollo y jugo natural"
                    android:textColor="#333333"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- MENU 2 -->
            <LinearLayout
                android:id="@+id/menu2"
                android:layout_width="match_parent"
                android:layout_height="85dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/borde"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">

                <RadioButton
                    android:id="@+id/radioMenu2"
                    android:layout_width="35dp"
                    android:layout_height="wrap_content"
                    android:buttonTint="#D0D0D0" />

                <ImageView
                    android:id="@+id/imgMenu2"
                    android:layout_width="65dp"
                    android:layout_height="65dp"
                    android:contentDescription="Lentejas"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_2" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="Lentejas, arroz, huevo\nrevuelt o, ensalada y jugo"
                    android:textColor="#333333"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- MENU 3 -->
            <LinearLayout
                android:id="@+id/menu3"
                android:layout_width="match_parent"
                android:layout_height="85dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/borde"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">

                <RadioButton
                    android:id="@+id/radioMenu3"
                    android:layout_width="35dp"
                    android:layout_height="wrap_content"
                    android:buttonTint="#D0D0D0" />

                <ImageView
                    android:id="@+id/imgMenu3"
                    android:layout_width="65dp"
                    android:layout_height="65dp"
                    android:contentDescription="Pasta"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_1" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="Pasta con carne molida,\nensalada y jugo"
                    android:textColor="#333333"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </RadioGroup>

        <!-- BOTON GUARDAR -->
        <TextView
            android:id="@+id/btnVerMas"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/boton_ver_mas"
            android:gravity="center"
            android:text="Guardar"
            android:textColor="#59933C"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- AVISO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/aviso_amarillo"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/circulo_amarillo"
                android:contentDescription="Información" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Este menú será visible para todas\nlas manipuladoras."
                android:textColor="#56704D"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>