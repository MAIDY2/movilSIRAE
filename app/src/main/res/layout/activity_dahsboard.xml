<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="#F8F9FA">

<androidx.core.widget.NestedScrollView
android:layout_width="match_parent"
android:layout_height="match_parent"
android:fillViewport="true">

<androidx.constraintlayout.widget.ConstraintLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:paddingBottom="32dp">

<View
android:id="@+id/bgHeader"
android:layout_width="0dp"
android:layout_height="180dp"
android:background="@drawable/fondo_encabezado"
app:layout_constraintEnd_toEndOf="parent"
app:layout_constraintStart_toStartOf="parent"
app:layout_constraintTop_toTopOf="parent" />

<TextView
android:id="@+id/lblBienvenida"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:layout_marginTop="20dp"
android:text="¡Bienvenido!"
android:textColor="#212121"
android:textSize="18sp"
android:textStyle="bold"
app:layout_constraintEnd_toEndOf="parent"
app:layout_constraintStart_toStartOf="parent"
app:layout_constraintTop_toTopOf="parent" />

<TextView
android:id="@+id/txtNombreUsuario"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:layout_marginTop="2dp"
android:text="EL PEPE"
android:textColor="#111111"
android:textSize="24sp"
android:textStyle="bold"
app:layout_constraintEnd_toEndOf="parent"
app:layout_constraintStart_toStartOf="parent"
app:layout_constraintTop_toBottomOf="@id/lblBienvenida" />

<!-- Rol -->
<TextView
android:id="@+id/txtRol"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:layout_marginTop="2dp"
android:text="Supervisor PAE - Valle del Cauca"
android:textColor="#424242"
android:textSize="13sp"
app:layout_constraintEnd_toEndOf="parent"
app:layout_constraintStart_toStartOf="parent"
app:layout_constraintTop_toBottomOf="@id/txtNombreUsuario" />

<!-- TARJETA FLOTANTE (Anclada a la parte inferior del fondo amarillo) -->
<com.google.android.material.card.MaterialCardView
android:id="@+id/cardEntrega"
android:layout_width="0dp"
android:layout_height="wrap_content"
android:layout_marginStart="20dp"
android:layout_marginTop="20dp"
android:layout_marginEnd="20dp"
app:cardBackgroundColor="#FFFFFF"
app:cardCornerRadius="20dp"
app:cardElevation="6dp"
app:strokeWidth="0dp"
app:layout_constraintEnd_toEndOf="parent"
app:layout_constraintStart_toStartOf="parent"
app:layout_constraintTop_toBottomOf="@id/bgHeader">

<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:gravity="center_vertical"
android:orientation="horizontal"
android:padding="18dp">

<com.google.android.material.card.MaterialCardView
android:layout_width="48dp"
android:layout_height="48dp"
app:cardBackgroundColor="#FFF8E1"
app:cardCornerRadius="14dp"
app:cardElevation="0dp"
app:strokeWidth="0dp">

<ImageView
android:layout_width="26dp"
android:layout_height="26dp"
android:layout_gravity="center"
android:src="@android:drawable/ic_menu_agenda"
app:tint="#FFB300" />
</com.google.android.material.card.MaterialCardView>

<LinearLayout
android:layout_width="0dp"
android:layout_height="wrap_content"
android:layout_marginStart="16dp"
android:layout_weight="1"
android:orientation="vertical">

<TextView
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="Próxima entrega general"
android:textColor="#757575"
android:textSize="13sp" />

<TextView
android:id="@+id/txtDiasEntrega"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="Faltan 8 días"
android:textColor="#111111"
android:textSize="20sp"
android:textStyle="bold" />
</LinearLayout>
</LinearLayout>
</com.google.android.material.card.MaterialCardView>

<TextView
android:id="@+id/lblResumen"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:layout_marginStart="24dp"
android:layout_marginTop="24dp"
android:text="Resumen de Inventario"
android:textColor="#111111"
android:textSize="20sp"
android:textStyle="bold"
app:layout_constraintStart_toStartOf="parent"
app:layout_constraintTop_toBottomOf="@id/cardEntrega" />

<LinearLayout
android:id="@+id/gridMetrics"
android:layout_width="0dp"
android:layout_height="wrap_content"
android:layout_marginStart="12dp"
android:layout_marginTop="12dp"
android:layout_marginEnd="12dp"
android:orientation="horizontal"
app:layout_constraintEnd_toEndOf="parent"
app:layout_constraintStart_toStartOf="parent"
app:layout_constraintTop_toBottomOf="@id/lblResumen">

<com.google.android.material.card.MaterialCardView
android:layout_width="0dp"
android:layout_height="140dp"
android:layout_margin="8dp"
android:layout_weight="1"
app:cardBackgroundColor="#FFFFFF"
app:cardCornerRadius="16dp"
app:cardElevation="2dp"
app:strokeWidth="0dp">

<LinearLayout
android:layout_width="match_parent"
android:layout_height="match_parent"
android:gravity="center"
android:orientation="vertical"
android:padding="12dp">

<TextView
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="txtTotalInventario"
android:textColor="#616161"
android:textSize="12sp" />

<TextView
android:id="@+id/txtTotalProductos"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:layout_marginVertical="2dp"
android:text="128"
android:textColor="#1E88E5"
android:textSize="32sp"
android:textStyle="bold" />

<TextView
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:gravity="center"
android:text="Total Productos\nregistrados"
android:textColor="#757575"
android:textSize="11sp" />
</LinearLayout>
</com.google.android.material.card.MaterialCardView>

<com.google.android.material.card.MaterialCardView
android:layout_width="0dp"
android:layout_height="140dp"
android:layout_margin="8dp"
android:layout_weight="1"
app:cardBackgroundColor="#FFFFFF"
app:cardCornerRadius="16dp"
app:cardElevation="2dp"
app:strokeWidth="0dp">

<LinearLayout
android:layout_width="match_parent"
android:layout_height="match_parent"
android:gravity="center"
android:orientation="vertical"
android:padding="12dp">

<TextView
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="txtDisponibles"
android:textColor="#616161"
android:textSize="12sp" />

<TextView
android:id="@+id/txtDisponibles"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:layout_marginVertical="2dp"
android:text="96"
android:textColor="#43A047"
android:textSize="32sp"
android:textStyle="bold" />

<TextView
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:gravity="center"
android:text="Productos con\nstock suficiente"
android:textColor="#757575"
android:textSize="11sp" />
</LinearLayout>
</com.google.android.material.card.MaterialCardView>

</LinearLayout>

<com.google.android.material.card.MaterialCardView
android:layout_width="0dp"
android:layout_height="wrap_content"
android:layout_marginStart="20dp"
android:layout_marginTop="8dp"
android:layout_marginEnd="20dp"
app:cardBackgroundColor="#FFC107"
app:cardCornerRadius="20dp"
app:cardElevation="4dp"
app:strokeWidth="0dp"
app:layout_constraintEnd_toEndOf="parent"
app:layout_constraintStart_toStartOf="parent"
app:layout_constraintTop_toBottomOf="@id/gridMetrics">

<LinearLayout
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:gravity="center"
android:orientation="vertical"
android:padding="20dp">

<LinearLayout
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:gravity="center_vertical"
android:orientation="horizontal">

<ImageView
android:layout_width="28dp"
android:layout_height="28dp"
android:src="@android:drawable/ic_dialog_alert"
app:tint="#D84315" />

<TextView
android:id="@+id/txtCriticos"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:layout_marginStart="8dp"
android:text="20"
android:textColor="#D84315"
android:textSize="30sp"
android:textStyle="bold" />
</LinearLayout>

<TextView
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:layout_marginTop="6dp"
android:text="Productos próximos a agotarse"
android:textColor="#212121"
android:textSize="15sp"
android:textStyle="bold" />

<TextView
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:layout_marginTop="2dp"
android:text="Requieren reposición inmediata"
android:textColor="#424242"
android:textSize="13sp" />

</LinearLayout>
</com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>